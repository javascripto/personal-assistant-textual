Screen {
    background: $background;
    color: $foreground;
    align: center top;
}

#application-frame {
    width: 100%;
    height: 100%;
}

#clock {
    width: 10;
    height: 1;
    text-align: right;
    padding: 0 1;
    background: $success;
    color: $background;
    text-style: bold;
}

#application-header {
    height: 1;
    background: $primary;
}

#main-panel {
    border: solid $primary-lighten-2;
    margin: 0;
    height: 1fr;
    background: $surface;
}

#panel-title {
    width: 1fr;
    height: 1;
    text-align: center;
    background: $primary;
    color: $foreground;
    text-style: bold;
}

#order-label {
    height: 2;
    padding: 1 2 0 2;
}

TabbedContent, ContentSwitcher, TabPane, DataTable {
    height: 1fr;
}

Tabs, Tab {
    background: $surface;
}

Tab {
    color: $foreground-muted;
}

Tab.-active {
    background: $primary-lighten-1;
    color: $foreground;
    text-style: bold;
}

DataTable {
    background: $surface;
    color: $foreground;
}

DataTable > .datatable--header {
    background: $secondary;
    color: $foreground;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary-lighten-1;
    color: $foreground;
}

#command-bar {
    dock: bottom;
    background: $primary;
    color: $foreground;
    padding: 0 1;
}

#task-dialog, #confirm-dialog, #task-details-dialog {
    width: 66;
    height: auto;
    border: double $primary-lighten-2;
    background: $background;
    padding: 1 2;
}

#task-dialog {
    height: 80%;
    max-height: 32;
}

#task-details-dialog {
    width: 90%;
    height: 75%;
    max-width: 100;
}

ModalScreen {
    align: center middle;
}

#dialog-title {
    width: 1fr;
    margin-bottom: 1;
    text-align: center;
    background: $primary;
    color: $foreground;
    text-style: bold;
}

#task-dialog Input {
    margin-bottom: 1;
}

#task-description, #details-description {
    height: 1fr;
    margin-bottom: 1;
}

#task-dialog Horizontal, #confirm-dialog Horizontal, #task-details-dialog Horizontal {
    height: 3;
    align-horizontal: center;
}

#task-dialog Button, #confirm-dialog Button, #task-details-dialog Button {
    margin: 0 1;
}

#confirm-task-title {
    color: $warning;
    margin-bottom: 1;
}

#details-title {
    color: $accent;
    text-style: bold;
}

#details-metadata {
    color: $foreground-muted;
    margin-bottom: 1;
}
