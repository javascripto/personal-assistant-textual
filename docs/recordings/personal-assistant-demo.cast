[125.8152, "o", "  \u001b[36mhelp    \u001b[0m  Lista os comandos disponíveis.\r\n  \u001b[36minstall \u001b[0m  Instala as dependências bloqueadas pelo uv.\r\n  \u001b[36mlint    \u001b[0m  Executa análise estática com Ruff, mypy e BasedPyright.\r\n"]
[125.815227, "o", "  \u001b[36mformat  \u001b[0m  Formata o código com Ruff e Black.\r\n  \u001b[36mtest    \u001b[0m  Executa os testes automatizados.\r\n"]
[125.815364, "o", "  \u001b[36mcheck   \u001b[0m  Valida formatação, lint, tipos e testes sem alterar arquivos.\r\n  \u001b[36mrun     \u001b[0m  Inicia a interface Textual.\r\n  \u001b[36mseed    \u001b[0m  Faz backup e insere tarefas genéricas ausentes no banco SQLite local.\r\n  \u001b[36mclear   \u001b[0m  Remove somente caches e relatórios gerados; preserva SQLite e exports.\r\n  \u001b[36mrecord-demo\u001b[0m  Inicia a gravação interativa em docs/recordings/.\r\n  \u001b[36mplay-demo\u001b[0m  Reproduz a demonstração asciinema no terminal.\r\n"]
[125.815396, "o", "  \u001b[36mbuild-demo\u001b[0m  Grava a demo validada em base isolada e gera o vídeo MP4.\r\n  \u001b[36mrender-demo\u001b[0m  Converte a captura real em MP4 1080p com capítulos.\r\n"]
[125.8154, "o", "  \u001b[36mdemo-check\u001b[0m  Valida os scripts de gravação e renderização com tipos estritos.\r\n"]
