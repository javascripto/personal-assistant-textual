#!/usr/bin/expect -f
# Compatibility entry point: the Python driver drains and validates the PTY.
set script_dir [file dirname [file normalize [info script]]]
set project_dir [file normalize [file join $script_dir ..]]
cd $project_dir
if {[catch {
    exec uv run --group demo python scripts/capture_demo.py >@stdout 2>@stderr
} result]} {
    puts stderr $result
    exit 1
}
