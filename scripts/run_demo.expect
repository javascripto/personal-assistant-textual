#!/usr/bin/expect -f
# Drive the actual shell and Textual application used in the recording.

set timeout 45
set project_dir [lindex $argv 0]
set demo_dir [exec mktemp -d /tmp/personal-assistant-demo.XXXXXX]

proc pause {} {
    after 500
}

log_user 0
spawn zsh -f
send -- "stty -echo\r"
after 500
log_user 1
after 500
send -- "export PS1='demo> '\r"
pause
send -- "cd $project_dir\r"
pause
send -- "clear\r"

# Run in an empty directory so only temporary demonstration data is created.
send -- "cd $demo_dir && uv run --project $project_dir personal-assistant\r"
after 2000

# Sort, create a task with a long description, and inspect its details.
send -- "o"
pause
send -- "n"
pause
send -- "Planejar demonstracao"
pause
send -- "\t"
pause
send -- "demo"
pause
send -- "\t"
pause
send -- "Registrar os passos da demonstracao e validar o resultado final."
pause
send -- "\t"
pause
send -- "\r"
pause
send -- "\033\[H"
pause
send -- "\r"
pause

# Edit directly from the details modal and return to the table.
send -- "e"
pause
send -- "\001Planejar demonstracao completa"
pause
send -- "\t"
pause
send -- "\001documentacao"
pause
send -- "\t"
pause
send -- "\001Descricao atualizada durante a demonstracao da interface."
pause
send -- "\t"
pause
send -- "\r"
pause
send -- "\r"
pause
send -- "\033"
pause

# Show status, tab focus, filters, theme, export and safe deletion.
send -- " "
pause
send -- "\t"
send -- "\033\[C"
pause
send -- "\t"
pause
send -- "t"
pause
send -- "x"
pause
send -- "d"
pause
send -- "\r"
pause
send -- "q"
after 1000
send -- "cd $project_dir\r"
pause
send -- "make help\r"
after 1500
send -- "make format\r"
after 2000
send -- "make check\r"
after 8000
send -- "cd $demo_dir\r"
pause
send -- "ls -1 exports\r"
after 1000
send -- "exit\r"
expect eof

file delete -force $demo_dir
